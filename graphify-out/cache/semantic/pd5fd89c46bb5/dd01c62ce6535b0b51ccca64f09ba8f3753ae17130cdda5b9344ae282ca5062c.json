{"nodes": [{"id": "docs_api_reference_public_rest_api", "label": "Public REST API (v1)", "file_type": "concept", "source_file": "docs/API_REFERENCE.md", "source_location": "top-level", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trigger-and-fetch only: workflows are created in the visual UI; the public /v1 surface and the internal /api JWT surface are intentionally independent."}, {"id": "docs_api_reference_api_key_authentication", "label": "API Key Authentication", "file_type": "concept", "source_file": "docs/API_REFERENCE.md", "source_location": "Authentication", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plaintext sk_live_ key shown once, only its SHA-256 hash stored; keys cannot be minted or revoked through the public API, so a leaked key cannot escalate to mint more keys. Revocation is immediate."}, {"id": "docs_api_reference_idempotency", "label": "Idempotency Keys", "file_type": "concept", "source_file": "docs/API_REFERENCE.md", "source_location": "Conventions - Idempotency", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retrying POST /v1/workflows/:id/runs with the same Idempotency-Key returns the original run instead of triggering a duplicate; reusing a key against a different workflow is a 409 so mistakes fail loudly."}, {"id": "docs_api_reference_cursor_pagination", "label": "Cursor Pagination", "file_type": "concept", "source_file": "docs/API_REFERENCE.md", "source_location": "Conventions - Pagination", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cursor-based, never offset-based, so pages do not shift when new runs appear; limit 1-100, default 20."}, {"id": "docs_api_reference_error_shape", "label": "Consistent Error Shape", "file_type": "concept", "source_file": "docs/API_REFERENCE.md", "source_location": "Conventions - Errors", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every error on every endpoint shares one shape with a request_id; not_found / no_data never distinguish 'does not exist' from 'is not yours' to avoid leaking resource existence."}, {"id": "docs_api_reference_rate_limits", "label": "Per-key Rate Limits", "file_type": "concept", "source_file": "docs/API_REFERENCE.md", "source_location": "Conventions - Rate limits", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_reference_workflows_endpoints", "label": "Workflows Endpoints (read-only)", "file_type": "concept", "source_file": "docs/API_REFERENCE.md", "source_location": "Endpoints - Workflows", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_reference_runs_endpoints", "label": "Runs Endpoints (trigger/list/status/cancel)", "file_type": "concept", "source_file": "docs/API_REFERENCE.md", "source_location": "Endpoints - Runs", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_reference_run_data_export", "label": "Run Data Export (JSON/CSV/XLSX)", "file_type": "concept", "source_file": "docs/API_REFERENCE.md", "source_location": "Endpoints - Runs - /data", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_reference_webhooks", "label": "Webhooks (push instead of poll)", "file_type": "concept", "source_file": "docs/API_REFERENCE.md", "source_location": "Endpoints - Webhooks", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_reference_run_completed_event", "label": "run.completed Event", "file_type": "concept", "source_file": "docs/API_REFERENCE.md", "source_location": "Webhooks", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_reference_run_failed_event", "label": "run.failed Event", "file_type": "concept", "source_file": "docs/API_REFERENCE.md", "source_location": "Webhooks", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_reference_run_changed_event", "label": "run.changed Event", "file_type": "concept", "source_file": "docs/API_REFERENCE.md", "source_location": "Webhooks", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fires when a workflow with change monitoring enabled produces data differing from its previous run; payload adds a changes object with the diff summary alongside run. See PLATFORM_ANALYSIS 6.5."}, {"id": "docs_api_reference_webhook_signature_verification", "label": "Webhook Signature Verification (HMAC-SHA256)", "file_type": "concept", "source_file": "docs/API_REFERENCE.md", "source_location": "Webhooks - Verifying signatures", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v1 = HMAC_SHA256(secret, t + '.' + raw body) with a 300s replay-tolerance window; HMAC computed over raw body bytes before JSON parsing."}, {"id": "docs_api_reference_usage_quota", "label": "Usage & Quota Metering", "file_type": "concept", "source_file": "docs/API_REFERENCE.md", "source_location": "Endpoints - Account", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only API-triggered runs are metered; runs_quota null means unlimited."}, {"id": "docs_api_reference_apiworker", "label": "apiWorker (async execution)", "file_type": "concept", "source_file": "docs/API_REFERENCE.md", "source_location": "How it runs (operator notes)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The DB is the queue: POST /runs only inserts a queued runs row; apiWorker claims it with an atomic conditional UPDATE (same pattern as the scheduler), no Redis. Race-safe across processes, so it can later move to a dedicated process or BullMQ as a pure deployment change."}, {"id": "docs_api_reference_execution_pipeline", "label": "Execution Pipeline (shared with API)", "file_type": "concept", "source_file": "docs/API_REFERENCE.md", "source_location": "Endpoints - Runs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "API-triggered runs go through the exact same pipeline as UI and scheduled runs, so self-healing, workflow versioning, and run history all apply."}, {"id": "docs_api_reference_needs_review_status", "label": "needs_review Run Status", "file_type": "concept", "source_file": "docs/API_REFERENCE.md", "source_location": "The core loop", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Means the run finished but self-healing left something for a human; partial data may still be available via /data."}], "edges": [{"source": "docs_api_reference_public_rest_api", "target": "docs_api_reference_api_key_authentication", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API_REFERENCE.md", "source_location": "Authentication", "weight": 1.0}, {"source": "docs_api_reference_public_rest_api", "target": "docs_api_reference_idempotency", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API_REFERENCE.md", "source_location": "Conventions", "weight": 1.0}, {"source": "docs_api_reference_public_rest_api", "target": "docs_api_reference_cursor_pagination", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API_REFERENCE.md", "source_location": "Conventions", "weight": 1.0}, {"source": "docs_api_reference_public_rest_api", "target": "docs_api_reference_error_shape", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API_REFERENCE.md", "source_location": "Conventions", "weight": 1.0}, {"source": "docs_api_reference_public_rest_api", "target": "docs_api_reference_rate_limit